<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="cardBg" format="reference" />
    <attr name="tileBg" format="reference" />
    <attr name="dockBg" format="reference" />
    <attr name="inputBg" format="reference" />
    <attr name="dividerColor" format="reference|color" />

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0E13</item>
        <item name="android:statusBarColor">#0B0E13</item>
        <item name="android:navigationBarColor">#0B0E13</item>
        <item name="android:colorAccent">#00E5A0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="cardBg">@drawable/card_bg</item>
        <item name="tileBg">@drawable/tile_bg</item>
        <item name="dockBg">@drawable/dock_bg</item>
        <item name="inputBg">@drawable/input_bg</item>
        <item name="dividerColor">#232C42</item>
    </style>

    <style name="AppThemeAmoled" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:colorAccent">#00E5A0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="cardBg">@drawable/card_bg_a</item>
        <item name="tileBg">@drawable/tile_bg_a</item>
        <item name="dockBg">@drawable/dock_bg_a</item>
        <item name="inputBg">@drawable/input_bg_a</item>
        <item name="dividerColor">#1B2230</item>
    </style>
</resources>
