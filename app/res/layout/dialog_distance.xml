<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingRight="22dp"
    android:paddingTop="6dp">

    <TextView
        android:id="@+id/chipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RECENT"
        android:textSize="9sp"
        android:letterSpacing="0.15"
        android:textColor="#66708A" />

    <LinearLayout
        android:id="@+id/chipRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/chip0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_off"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#00E5A0" />

        <TextView
            android:id="@+id/chip1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/badge_off"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#00E5A0" />

        <TextView
            android:id="@+id/chip2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/badge_off"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#00E5A0" />
    </LinearLayout>

    <EditText
        android:id="@+id/dlgKm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="?attr/inputBg"
        android:padding="14dp"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#F2F5FA"
        android:textColorHint="#3A4358"
        android:hint="0.0"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:imeOptions="actionNext" />

    <TextView
        android:id="@+id/dlgHelper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:text="DOT = METERS. 3.5 = 3 KM 500 M"
        android:textSize="9sp"
        android:letterSpacing="0.1"
        android:textColor="#66708A" />
</LinearLayout>
